# Mozart Unified Dashboard - environment configuration
# Copy this file to .env and fill in your own values.
# Do NOT commit your real .env file.

# --- TestRail ---
TESTRAIL_URL=
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=

# --- Local paths ---
WORKSPACE_PATH=
FAILURE_ANALYZER_PATH=
SKIP_TOOL_PATH=

# --- Code review (CR Analyzer) ---
CODE_REVIEW_HOST=
CODE_REVIEW_COOKIE=~/.review/cookie

# --- Git ---
DEFAULT_GIT_REMOTE=origin
